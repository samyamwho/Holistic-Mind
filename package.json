{
  "name": "holistic-mind",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:local": "EXPO_PUBLIC_API_URL=http://127.0.0.1:4000 expo run:ios",
    "start:local": "EXPO_PUBLIC_API_URL=http://127.0.0.1:4000 expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "api:dev": "npm --prefix backend run dev",
    "api:build": "npm --prefix backend run build",
    "api:migrate": "npm --prefix backend run migrate",
    "api:seed:exercises": "npm --prefix backend run seed:exercises",
    "api:seed:library": "npm --prefix backend run seed:library",
    "content:export": "npm --prefix backend run content:export --",
    "content:import": "npm --prefix backend run content:import --",
    "api:smoke:audio": "npm --prefix backend run smoke:audio",
    "admin:dev": "npm --prefix admin run dev",
    "admin:build": "npm --prefix admin run build",
    "api:upload": "npm --prefix backend run upload --"
  },
  "dependencies": {
    "@bottom-tabs/react-navigation": "^1.3.1",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-file-system": "~19.0.24",
    "expo-glass-effect": "~0.1.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "lucide-react-native": "^1.23.0",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-bottom-tabs": "^1.3.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-pdf-renderer": "^2.3.0",
    "react-native-reanimated": "~4.1.1",
