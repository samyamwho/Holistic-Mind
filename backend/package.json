{
  "name": "holistic-mind-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"import('node:fs').then(fs => { fs.mkdirSync('dist/data', { recursive: true }); for (const name of ['exercises.json', 'library.json']) fs.copyFileSync('src/data/' + name, 'dist/data/' + name); })\"",
    "start": "node dist/server.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "seed:exercises": "tsx src/scripts/seedExercises.ts",
    "seed:exercises:prod": "node dist/scripts/seedExercises.js",
    "seed:library": "tsx src/scripts/seedLibrary.ts",
    "seed:library:prod": "node dist/scripts/seedLibrary.js",
    "content:export": "tsx src/scripts/exportContent.ts",
    "content:import": "tsx src/scripts/importContent.ts",
    "content:export:prod": "node dist/scripts/exportContent.js",
    "content:import:prod": "node dist/scripts/importContent.js",
    "smoke:auth": "EMAIL_DELIVERY_MODE=log tsx src/scripts/smokeAuth.ts",
    "test:email": "EMAIL_DELIVERY_MODE=resend RESEND_API_KEY=re_test_key tsx src/scripts/testEmailDelivery.ts",
    "smoke:audio": "tsx src/scripts/smokeAudio.ts",
    "smoke:recommendations": "tsx src/scripts/smokeRecommendations.ts",
    "upload": "tsx src/scripts/uploadVideo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@node-rs/argon2": "^2.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.3",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
