PORT=4000
API_BASE_URL=http://localhost:4000
APP_ORIGIN=*
ADMIN_API_KEY=replace-with-at-least-24-random-characters
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Database Configuration (supports Railway, Render, Supabase, Neon, AWS RDS, local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/holistic_mind
# DATABASE_SSL can be "auto", "true", or "false" (auto automatically enables SSL for remote hosts)
DATABASE_SSL=auto
AUTO_MIGRATE=true

# Object Storage Configuration (Cloudflare R2, AWS S3, or MinIO)
# For Cloudflare R2:
# S3_REGION=auto
# S3_BUCKET=holistic-mind-media
# S3_ENDPOINT=https://<YOUR_ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=<YOUR_R2_ACCESS_KEY>
# S3_SECRET_ACCESS_KEY=<YOUR_R2_SECRET_KEY>
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://pub-<HASH>.r2.dev or https://media.yourdomain.com

# For Local MinIO:
S3_REGION=auto
S3_BUCKET=holistic-mind-videos
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/holistic-mind-videos

# Recommender Service (FastAPI ONNX container)
# In Railway/Docker private networking: http://recommender:8000 or http://127.0.0.1:8000
RECOMMENDER_URL=http://localhost:8000
RECOMMENDER_TIMEOUT_MS=10000

# Email Delivery: "log" prints codes locally; production is required to use "resend".
# onboarding@resend.dev can only email the address that owns the Resend account.
# To email beta users, verify your own domain and use an address on that exact domain.
EMAIL_DELIVERY_MODE=log
EMAIL_FROM=Holistic Mind <onboarding@resend.dev>
RESEND_API_KEY=

# Google OAuth Web Client ID (optional, for Google Sign-In verification)
GOOGLE_WEB_CLIENT_ID=
