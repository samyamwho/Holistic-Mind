PORT=4000
API_BASE_URL=http://localhost:4000
APP_ORIGIN=*
ADMIN_API_KEY=replace-with-at-least-24-random-characters
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Use a hosted PostgreSQL URL in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/holistic_mind
DATABASE_SSL=false
AUTO_MIGRATE=true

# AWS S3, Cloudflare R2, and MinIO are supported.
S3_REGION=auto
S3_BUCKET=holistic-mind-videos
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/holistic-mind-videos

# Local-only Python recommendation service. No journal text is sent to an external API.
RECOMMENDER_URL=http://localhost:8000
RECOMMENDER_TIMEOUT_MS=10000

# Use "log" locally: verification/reset codes are printed by the backend.
# Use "resend" in production and supply a verified sender and API key.
EMAIL_DELIVERY_MODE=resend
EMAIL_FROM=Holistic Mind <onboarding@resend.dev>
RESEND_API_KEY= re_HHgxq2Cr_DgsAxJ8q23BHthYP5M3Gy2PV

# Web OAuth client ID used by the mobile SDK and verified by the backend.
GOOGLE_WEB_CLIENT_ID=
